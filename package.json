{
  "name": "dsh-qq-bot",
  "version": "0.3.2",
  "description": "DeepSeek Harness plugin bridging QQ official Bot API to dsh agents without a third-party bot framework.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "cordis.example.yml"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "strip-only:check": "node --experimental-strip-types test/strip-only-smoke.mjs",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm run strip-only:check && npm test",
    "pack:check": "npm pack --dry-run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "setup": "npm run build && node scripts/cli.mjs setup",
    "doctor": "npm run build && node scripts/cli.mjs doctor",
    "pretest": "npm run build",
    "init": "npm run build && node scripts/cli.mjs init"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "npm@10.9.8",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2 || 0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.0",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qq-bot",
    "qq-open-platform"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-qq-bot": "scripts/cli.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
